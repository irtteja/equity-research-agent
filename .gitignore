__pycache__/
*.pyc
*.pyo
**/__pycache__/
**/*.pyc
.env
*.egg-info/

# SQLite binaries — not tracked (gets overwritten by git pull, causes merge conflicts)
memory/research.db
memory/graph.db
memory/__pycache__/

# BSE cache
~/.bse_cache/

# Temp PDF downloads and bhavcopy files
/tmp/
BhavCopy_*.csv
*.zip

# IDE
.vscode/
.idea/
memory_store/graph.db
# SQLite WAL/SHM files — transient, never commit
memory_store/*.db-wal
memory_store/*.db-shm
*.db-wal
*.db-shm

# Large raw data — regenerated by scheduled tasks, not worth versioning
# documents/: raw PDF text already extracted into knowledge graph (877MB)
memory_store/documents/
# bhavcopy/: daily OHLCV CSVs regenerated each night
memory_store/bhavcopy/
memory_store/indices_bhavcopy/
# annual_reports/: PDFs too large; only index.json per ticker is committed
memory_store/annual_reports/**/*.pdf
# New high-volume daily sources (JSONL flat files, rebuilt from NSE each day)
memory_store/delivery_bhavcopy/
memory_store/participant_oi/
memory_store/surveillance/
# FII/DII, insider, pledge, SAST — keep (small, valuable history)
# memory_store/fii_dii/  → versioned
# memory_store/insider_trading/  → versioned
# memory_store/pledge_data/  → versioned
# memory_store/sast_reg29/  → versioned
